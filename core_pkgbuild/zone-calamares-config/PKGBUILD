# Maintainer: Gabriel Matthews <matthewriel63@gmail.com>

pkgname=zone-calamares-config
pkgver=r29.50ec8c8
pkgrel=1
epoch=1
pkgdesc="Calamares configuration and branding for The Zone"
arch=('any')
url="https://github.com/zone-linux/zone-calamares-config"
license=('GPL-3.0-or-later')
makedepends=('git')
provides=("${pkgname}")
options=(!strip !debug !emptydirs)
_srcbase="${ZONE_SRC_BASE:-https://github.com/zone-linux}"
source=("${pkgname}::git+${_srcbase}/${pkgname}")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    install -dm755 "${pkgdir}/etc"
    install -dm755 "${pkgdir}/usr"
    cp -a "${srcdir}/${pkgname}/etc/." "${pkgdir}/etc/"
    cp -a "${srcdir}/${pkgname}/usr/." "${pkgdir}/usr/"

    chmod 755 "${pkgdir}/usr/bin/calamares_polkit"
    chmod 644 "${pkgdir}/etc/skel/Desktop/calamares.desktop"
    chmod 644 "${pkgdir}/etc/polkit-1/rules.d/49-nopasswd-calamares.rules"
    chmod 750 "${pkgdir}/etc/polkit-1/rules.d"
}
