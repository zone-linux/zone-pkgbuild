# Maintainer: Gabriel Matthews <matthewriel63@gmail.com>
# Developer : Amir Salihefendic <@amix3k>

pkgname=zone-vim
pkgver=2026.11.06
pkgrel=1
pkgdesc="The ultimate Vim configuration (vimrc)"
arch=('any')
url='https://github.com/amix/vimrc'
license=('GPL')
options=(!strip !debug)
depends=('vim')
optdepends=()

# Pin the upstream commit: the archive is reproducible and does not require a
# full git clone. Update _commit and pkgver together, then run updpkgsums.
_commit=46294d589d15d2e7308cf76c58f2df49bbec31e8
source=("vimrc-$pkgver.tar.gz::https://codeload.github.com/amix/vimrc/tar.gz/${_commit}")
sha256sums=('b7f02493ae76e1272337d401dd976829b5bf189b512ae5d31e58fbdeefb05bf9')

prepare() {
    cd "${srcdir}/vimrc-${_commit}"

    # Show line numbers
    sed -i -e 's/set foldcolumn=.*/set foldcolumn=0/g' vimrcs/basic.vim
    sed -i -e '/set foldcolumn=0/a set number' vimrcs/basic.vim

    # Change color scheme
    sed -i -e 's/colorscheme .*/colorscheme ir_black/g' vimrcs/extended.vim

    # Create .vimrc file
    touch .vimrc
    cat >> ".vimrc" <<- _EOF_
		" DO NOT EDIT THIS FILE
		" Add your own customizations in ~/.vim_runtime/my_configs.vim

		set relativenumber
		set runtimepath+=~/.vim_runtime

		source ~/.vim_runtime/vimrcs/basic.vim
		source ~/.vim_runtime/vimrcs/filetypes.vim
		source ~/.vim_runtime/vimrcs/plugins_config.vim
		source ~/.vim_runtime/vimrcs/extended.vim
		try
		  source ~/.vim_runtime/my_configs.vim
		catch
		endtry
	_EOF_
}

package() {
    cd "${srcdir}/vimrc-${_commit}"
    mkdir -p "${pkgdir}/etc/skel/.vim_runtime"
    cp -r . "${pkgdir}/etc/skel/.vim_runtime"
    install -Dm644 ".vimrc" "${pkgdir}/etc/skel/.vimrc"
    rm "${pkgdir}/etc/skel/.vim_runtime/.vimrc"
}
